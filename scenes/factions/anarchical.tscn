description = "Four shells lob in from off the map onto the target point."
event_scene = ExtResource("19_m1")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Called in rather than fired: the shells come over the map edge nearest the\nDistress Signal that called them, so where you build the caster decides which\nside the barrage arrives from.\nThe muzzles are scattered; the aim is not. Every shell converges on the point\nyou clicked."
cooldown_duration = 60.0
ability_id = &"mortar"
ability_level = 1

