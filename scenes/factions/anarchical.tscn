[sub_resource type="Resource" id="Sanction_dignify"]
script = ExtResource("3_ord")
sanction_name = "Dignify"
description = "Promotes a clicked Irregular into a Warlord, keeping the veterancy it has already earned."
cooldown_duration = 30.0
event_scene = ExtResource("10_dig")
targeting = 1
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "A transformation, not a purchase: the Irregular is consumed and the Warlord stands\nin its place at the same spot, carrying its rank across.\n\nIts STANDING ORDERS come across too, as far as the new piece can carry them. The\nqueue is walked and truncated at the first command a Warlord cannot perform — a\nWarlord cannot build, so an Irregular told to raise a redoubt and then hold a hill\nkeeps neither order, since the second was given expecting the first to have happened."
ability_id = &"dignify"
ability_level = 1

[sub_resource type="Resource" id="Unlock_dignify"]
script = ExtResource("6_unlock")
sanction = SubResource("Sanction_dignify")
tier = 0
column = 0
dominion_cost = 150
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

