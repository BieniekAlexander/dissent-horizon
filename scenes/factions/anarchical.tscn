description = "Grants a clicked Irregular permanent stealth, letting it move unseen until it attacks."
cooldown_duration = 30.0
event_scene = ExtResource("11_inf")
targeting = 1
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Stealth is permanent once granted — it is a property of the unit from then on, not\na timed effect. The unit is revealed while it is inside an enemy detector's range,\nand forced fully visible for a few seconds after it attacks or is attacked."
