[sub_resource type="Resource" id="Sanction_scavenge1"]
script = ExtResource("3_ord")
sanction_name = "Scavenge 1"
description = "Every enemy unit or structure you destroy pays back 10% of its build cost in energy. Always on once unlocked — there is nothing to deploy."
passive = true
kill_bounty_fraction = 0.1
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "A STANDING benefit rather than a sanction you fire: unlocking it is the whole\nthing. It never appears on the deploy bar and has no cooldown.\n\nThe bounty is paid to whoever landed the killing blow, so it cannot be earned from\nyour own losses, from a unit that starves, or from one scuttled deliberately."
ability_id = &"scavenge"
ability_level = 1

[sub_resource type="Resource" id="Unlock_scavenge1"]
