[sub_resource type="Resource" id="Sanction_overcharge"]
script = ExtResource("3_ord")
sanction_name = "Overcharge"
description = "Dumps a huge surge into a single DISABLED unit. It can only be aimed at something already stunned — pair it with Global EMP."
event_scene = ExtResource("17_ov")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Worth nothing on its own and decisive after Global EMP: being disabled is a\nrequirement of the TARGET, not a damage bonus, so a click that finds no stunned\nunit does nothing at all.\n\nAny hard stun qualifies, including a Colonial cryogenic freeze — a frozen unit is\nexactly as helpless as an EMPed one.\n\nThe damage is flat rather than a share of the target's health. The pairing already\nguarantees the target cannot escape, so scaling it to size would make the\ncombination an unconditional kill on anything."
cooldown_duration = 60.0
ability_id = &"overcharge"
ability_level = 1

[sub_resource type="Resource" id="Unlock_overcharge"]
script = ExtResource("6_unlock")
sanction = SubResource("Sanction_overcharge")
tier = 3
column = 2
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_global_emp"]
script = ExtResource("3_ord")
sanction_name = "Global EMP"
description = "Stuns every machine on the map for five seconds — yours included. Your infantry does not care, which is the point."
needs_target = false
needs_vision = false
event_scene = ExtResource("18_ge")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Fires the moment you press it: there is nowhere to point a map-wide effect, so it\nis never armed and never waits on a click.\n\nIt catches YOUR machines too. That asymmetry is the mechanic rather than an\noversight — an EMP only takes hold on a mechanical frame, and the Anarchists field\ninfantry, so they pay almost nothing to fire it while a vehicle-heavy opponent\nstops dead. Sparing your own vehicles would erase the only real cost of fielding\nthem as this faction."
cooldown_duration = 60.0
ability_id = &"global_emp"
ability_level = 1

[sub_resource type="Resource" id="Unlock_global_emp"]
script = ExtResource("6_unlock")
sanction = SubResource("Sanction_global_emp")
tier = 3
column = 2
dominion_cost = 3000
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_mortar1"]
