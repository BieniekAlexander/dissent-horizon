[sub_resource type="Resource" id="Sanction_promotion"]
script = ExtResource("6_ord")
sanction_name = "Promotion"
description = "Grants the first veterancy level to a clicked friendly unit of any type. Only a unit that has not yet earned a level can be promoted this way."
event_scene = ExtResource("8_pro")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Starts a unit's career rather than shortening it. A unit that has already earned a level is not a valid target, so the ranks above Veteran stay earned in combat and no single favourite can be walked up to Heroic with dominion.\n\nOnly an UNBLOODED unit is marked as a target while it is armed; pointing at a unit that has already earned a level targets nothing."
cooldown_duration = 60.0
ability_id = &"promotion"
ability_level = 1

[sub_resource type="Resource" id="Unlock_promotion"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_promotion")
tier = 0
column = 0
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_drop1"]
script = ExtResource("6_ord")
sanction_name = "Drop 1"
description = "Flies 3 × Recruit in and drops them on the target point."
event_scene = ExtResource("11_d1")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The cheapest way to put bodies somewhere they are not expected — reinforcing a\ncollapsing defence, or opening a second front behind the enemy line.\n\nIt is a FLIGHT, not a spawn. A transport crosses the map from your side of the\nboard, releases the squad under canopy over the point you clicked, and flies on\nout the far side. Shoot the transport down on the way in and the shipment goes\nwith it."
cooldown_duration = 60.0
ability_id = &"drop"
ability_level = 1
payloads = Array[Dictionary]([{ "piece": &"cl_bioLight_antiLight", "count": 3 }])

[sub_resource type="Resource" id="Unlock_drop1"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_drop1")
tier = 1
column = 0
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_drop2"]
script = ExtResource("6_ord")
sanction_name = "Drop 2"
description = "Flies in a shipment of your choosing — 5 × Recruit, or a sloop."
event_scene = ExtResource("12_d2")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The level that turns Drop into a CHOICE. Pressing it opens a cargo menu the way Build\nopens a structure list; pick the shipment, then click where it goes.\n\nIt replaces Drop 1 outright rather than joining it — a column is one sanction you\nimprove — and improving it here means both a bigger squad than Drop 1 flew and a\nvehicle it could not carry at all."
cooldown_duration = 60.0
ability_id = &"drop"
ability_level = 2
payloads = Array[Dictionary]([{ "piece": &"cl_bioLight_antiLight", "count": 5 }, { "piece": &"cl_mechMedium_antiLight", "count": 1 }])

[sub_resource type="Resource" id="Unlock_drop2"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_drop2")
tier = 2
column = 0
parent = SubResource("Unlock_drop1")
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_drop3"]
script = ExtResource("6_ord")
sanction_name = "Drop 3"
description = "Flies in a shipment of your choosing, up to a Matilda."
event_scene = ExtResource("13_d3")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The heaviest shipment the Colonials can call in, and the reason to take the Drop\ncolumn to its end. Every option Drop 2 offered arrives in greater numbers, and the\nMatilda is added to the menu."
cooldown_duration = 60.0
ability_id = &"drop"
ability_level = 3
payloads = Array[Dictionary]([{ "piece": &"cl_bioLight_antiLight", "count": 7 }, { "piece": &"cl_mechMedium_antiLight", "count": 2 }, { "piece": &"cl_mechMedium_antiMech", "count": 1 }])

