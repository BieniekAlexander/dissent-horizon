metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_scan1"]
script = ExtResource("6_ord")
sanction_name = "Scan 1"
description = "Reveals the fog of war within 10 units of the target point for 15 seconds, then fades. Scouting without risking a unit."
event_scene = ExtResource("9_rad")
needs_vision = false
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The one family that may be aimed into ground you cannot see — a reveal that could\nonly be pointed at what you already had eyes on would be useful precisely where it\nis not needed.\n\nThe reveal is a real vision source for its lifetime, not a one-off snapshot, so\nanything that moves through the circle is seen while it is up."
cooldown_duration = 60.0
ability_id = &"scan"
ability_level = 1

[sub_resource type="Resource" id="Unlock_scan1"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_scan1")
tier = 0
column = 1
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_scan2"]
script = ExtResource("6_ord")
sanction_name = "Scan 2"
description = "Reveals the fog around the target point for 15 seconds and exposes any stealthed units caught in it, replacing Scan 1."
event_scene = ExtResource("14_s2")
needs_vision = false
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The same circle, now with detection: stealthed units inside it are revealed for as\nlong as the scan lasts. The counter to an opponent leaning on stealth."
cooldown_duration = 60.0
ability_id = &"scan"
ability_level = 2

[sub_resource type="Resource" id="Unlock_scan2"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_scan2")
tier = 1
column = 1
parent = SubResource("Unlock_scan1")
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_scan3"]
script = ExtResource("6_ord")
sanction_name = "Scan 3"
description = "Leaves a permanent eye over the target point — the same reveal and stealth detection, held indefinitely. Replaces Scan 2."
event_scene = ExtResource("15_s3")
needs_vision = false
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "A hovering observer that never expires. It cannot be commanded or selected, and it\nwatches the ground it was placed over for the rest of the match, unless the enemy\nshoots it down."
cooldown_duration = 60.0
ability_id = &"scan"
ability_level = 3

