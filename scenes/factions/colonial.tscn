[sub_resource type="Resource" id="Sanction_freeze1"]
script = ExtResource("6_ord")
sanction_name = "Freeze 1"
description = "Freezes one of YOUR units for 15 seconds — it can take no action at all, but its armour rises a step while it stands there. A way to save something about to die."
event_scene = ExtResource("16_f1")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Cryogenics cut both ways: a frozen unit is helpless and tougher at the same time.\nFreezing your own unit trades everything it could have done for a step of armour,\nwhich is how you carry something through a barrage it would not otherwise survive.\n\nUnits already at STRONG armour cannot be frozen — there is no step above it, so\nthey would take the immobilisation with none of the protection. Structures cannot\nbe frozen either."
cooldown_duration = 60.0
ability_id = &"freeze"
ability_level = 1

[sub_resource type="Resource" id="Unlock_freeze1"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_freeze1")
tier = 0
column = 2
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_freeze2"]
script = ExtResource("6_ord")
sanction_name = "Freeze 2"
description = "Freezes any unit for 15 seconds — friendly or hostile. It can take no action, and its armour rises a step. Replaces Freeze 1. Strong armour cannot be frozen."
event_scene = ExtResource("17_f2")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The same effect, now aimable at anyone. On an enemy it is a hard removal from the\nfight for 15 seconds; the armour step it also grants them is the cost of using it\noffensively, so it takes a unit out of a fight rather than setting one up to die."
cooldown_duration = 60.0
ability_id = &"freeze"
ability_level = 2

[sub_resource type="Resource" id="Unlock_freeze2"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_freeze2")
tier = 2
column = 2
parent = SubResource("Unlock_freeze1")
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

