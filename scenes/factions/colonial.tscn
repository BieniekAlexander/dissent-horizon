[sub_resource type="Resource" id="Sanction_beacon1"]
script = ExtResource("6_ord")
sanction_name = "Beacon 1"
description = "Places a firing solution at the target point for 15 seconds. Any Bombard can then shell it from anywhere on the map."
event_scene = ExtResource("21_b1")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "The artillery's reach without the walk. A Recruit can call a\nsolution in for free, but it has to get there, hold still for ten seconds and stay\nuntil the shot lands; this puts one wherever you can see, immediately.\n\nWhat you pay for that is a clock: the beacon stands for 15 seconds and is gone\nwhether or not a gun used it.\n\nThe beacon is spent by the first shell that uses it, exactly like a spotter's."
cooldown_duration = 60.0
ability_id = &"beacon"
ability_level = 1

[sub_resource type="Resource" id="Unlock_beacon1"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_beacon1")
tier = 1
column = 3
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_beacon2"]
script = ExtResource("6_ord")
sanction_name = "Beacon 2"
description = "The same solution, and it now lights the fog around itself (radius 2). Replaces Beacon 1."
event_scene = ExtResource("22_b2")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "A blind beacon marks ground you already had eyes on. This one brings its own, so it\ncan be dropped into the shroud and show you what it is standing next to — which is\nusually what you wanted to shell."
cooldown_duration = 60.0
ability_id = &"beacon"
ability_level = 2

[sub_resource type="Resource" id="Unlock_beacon2"]
script = ExtResource("7_unlock")
sanction = SubResource("Sanction_beacon2")
tier = 2
column = 3
parent = SubResource("Unlock_beacon1")
dominion_cost = 500
metadata/_custom_type_script = "uid://bhm0bavkjvt0q"

[sub_resource type="Resource" id="Sanction_beacon3"]
script = ExtResource("6_ord")
sanction_name = "Beacon 3"
description = "The solution now stands until a shell spends it, rather than expiring. Replaces Beacon 2."
event_scene = ExtResource("23_b3")
metadata/_custom_type_script = "uid://cteoy2vx2l533"
verbose_description = "Drops the clock. The solution keeps its small sight radius and waits indefinitely,\nso it can be placed before the guns are ready rather than in the same breath."
cooldown_duration = 60.0
ability_id = &"beacon"
ability_level = 3

