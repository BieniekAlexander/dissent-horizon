[node name="MinimapBorder" type="ColorRect" parent="Controller"]
## Grey backing rect that forms a 4 px visual border around the minimap.
## Must sit before Minimap in the tree so it renders behind it.
## Dimensions: minimap (192×108) + 4 px on every side = 200×116.
## Anchored to bottom-right with the same 8 px screen margin as the minimap,
## extended 4 px outward in each direction.
layout_mode = 1
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -204.0
offset_top = -120.0
offset_right = -4.0
offset_bottom = -4.0
grow_horizontal = 0
grow_vertical = 0
color = Color(0.35, 0.35, 0.35, 1.0)

[node name="Minimap" type="TextureRect" parent="Controller"]
