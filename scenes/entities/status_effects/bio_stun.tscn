[node name="BioStun" type="Node"]
script = ExtResource("1_fx")
title = "Choking"
description = "Living crews are down: no orders answered until it clears."
valence = 2
verbose = "A gas or shock payload that acts on BIO frames only — a machine hit by the same round shrugs it off.\nA choking unit does NOTHING: it does not move, shoot, build or defend itself. That is a harder stop than the stagger an ordinary hit causes, which suppresses only the channeled jobs."
duration_ticks = 30
host_tint = Color(0.55, 0.78, 0.42, 1)
indicator_icon = ExtResource("2_bio")
indicator_blink_hz = 2.5
affects_frames = 1
