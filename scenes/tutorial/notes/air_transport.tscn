[node name="AirTransport" type="VBoxContainer"]
layout_mode = 3
anchors_preset = 0
script = ExtResource("1_page")
title = "Air transport"
body = "A Raven carries up to 8 infantry.\n\n[b]Load:[/b] select infantry and {{ command_issue }} a Raven.\n[b]Fly:[/b] select the Raven and {{ command_issue }} where it should go.\n[b]Land:[/b] press Land ({{ command_land }}) on the command card.\n[b]Unload:[/b] press Evacuate ({{ command_evacuate }}) on the command card."
acknowledge_text = "Got it"
metadata/_custom_type_script = "uid://b60p17fa5hvfc"
