script = ExtResource("1_page")
title = "How to Play"
body = "Press {{ show_pause_menu }}, or the button at the top right of the screen, to open the pause menu. Its [b]Briefing[/b] tab lists your objectives in detail, and [b]How to Play[/b] keeps every note like this one, grouped by topic, with the ones you have been shown highlighted. The game waits while the menu is open."
acknowledge_text = "Got it"
