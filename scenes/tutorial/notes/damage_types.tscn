script = ExtResource("1_page")
title = "Damage types"
body = "Every unit and structure has a frame, BIO or MECH, and an armour class. How much a weapon hurts depends on both:\n\n[b]Explosives[/b] are effective against MECH units and structures.\n[b]Ballistics[/b] are effective against BIO units and light armour."
acknowledge_text = "Got it"
