script = ExtResource("1_page")
title = "Watch Towers and SAM sites"
body = "A Watch Tower's machine gun shreds lightly armoured infantry. Steer clear of them until you have more heavily armoured units.\n\nWatch Towers shoot only at units on the ground, and SAM sites only at aircraft."
acknowledge_text = "Got it"
