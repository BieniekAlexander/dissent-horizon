script = ExtResource("1_page")
title = "Field Command"
body = "Your cell has gone loud, commander. We will walk you through the basics.

The world is held while you read — take your time. Orders you give now are still accepted; they simply wait for the world to resume."
acknowledge_text = "Understood"
