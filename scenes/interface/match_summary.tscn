[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/interface/hud/match_summary_view.gd" id="1_summary"]

[node name="MatchSummary" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
script = ExtResource("1_summary")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Match summary"
horizontal_alignment = 1

[node name="Table" type="GridContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 24
columns = 3

[node name="BreakdownScroll" type="ScrollContainer" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Breakdown" type="GridContainer" parent="Margin/Column/BreakdownScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 24

[node name="Source" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1

[node name="CloseButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 36)
layout_mode = 2
size_flags_horizontal = 4
text = "Close"
